# ─────────────────────────────────────────────────────────────
# ENG TRACKER — Variables de Entorno
# Copiar como .env.local — NUNCA commitear al repositorio
# Cuenta Supabase: seguridad2053@gmail.com
# ─────────────────────────────────────────────────────────────

# ── Supabase ─────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://<project-id>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# ── Base de datos — Drizzle ORM ───────────────────────────────
# Pooled (pgBouncer puerto 6543) — para Server Actions y queries
DATABASE_URL=postgresql://postgres.<project-id>:<password>@aws-0-sa-east-1.pooler.supabase.com:6543/postgres

# Unpooled (puerto 5432) — para migraciones drizzle-kit
DATABASE_URL_UNPOOLED=postgresql://postgres:<password>@db.<project-id>.supabase.co:5432/postgres

# ── App ───────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://eng-tracker.vercel.app
NEXT_PUBLIC_APP_NAME=ENG Tracker

# ── Opcionales — módulos futuros ──────────────────────────────
GROQ_API_KEY=<api-key>        # Módulo AI / pronunciación
RESEND_API_KEY=<api-key>      # Emails transaccionales
